generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
}

enum SellerOrderStatus {
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PAID
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole        @default(CUSTOMER)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  seller       SellerProfile?
  addresses    Address[]
  carts        Cart[]
  orders       Order[]
  adminLogs    AdminActionLog[] @relation("AdminActor")
  sessions     AuthSession[]
}

model AuthSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthThrottle {
  key          String    @id
  attempts     Int       @default(0)
  windowStart  DateTime  @default(now())
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt
}

model SellerProfile {
  id            String                       @id @default(cuid())
  userId        String                       @unique
  shopName      String
  slug          String                       @unique
  logoUrl       String?
  contactEmail  String
  contactPhone  String
  address       String
  bankName      String
  bankAccount   String
  bankOwner     String
  status        SellerStatus                 @default(PENDING)
  rejectReason  String?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  user          User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents     SellerVerificationDocument[]
  products      Product[]
  sellerOrders  SellerOrder[]
  payouts       Payout[]
}

model SellerVerificationDocument {
  id        String        @id @default(cuid())
  sellerId  String
  fileName  String
  fileUrl   String
  mimeType  String
  createdAt DateTime      @default(now())
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

model Category {
  id        String     @id @default(cuid())
  nameTh    String
  nameEn    String
  slug      String     @unique
  parentId  String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
}

model Product {
  id           String           @id @default(cuid())
  sellerId     String
  categoryId   String
  name         String
  slug         String           @unique
  brand        String
  description  String
  status       ProductStatus    @default(DRAFT)
  rejectReason String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  seller       SellerProfile    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category     Category         @relation(fields: [categoryId], references: [id])
  variants     ProductVariant[]
  images       ProductImage[]
  orderItems   OrderItem[]

  @@index([status])
  @@index([categoryId])
  @@index([sellerId])
}

model ProductVariant {
  id           String                 @id @default(cuid())
  productId    String
  sku          String                 @unique
  size         String
  color        String
  priceThb     Int
  stockOnHand  Int
  reserved     Int                    @default(0)
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  orderItems   OrderItem[]
  reservations InventoryReservation[]
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String
  position  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Address {
  id          String   @id @default(cuid())
  userId      String?
  fullName    String
  phone       String
  line1       String
  province    String
  district    String
  postalCode  String
  countryCode String   @default("TH")
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders      Order[]
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  guestId   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([guestId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String?
  guestEmail    String?
  guestPhone    String?
  lookupToken   String        @unique
  addressId     String
  status        OrderStatus   @default(PENDING_PAYMENT)
  subtotalThb   Int
  shippingThb   Int
  totalThb      Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  address       Address       @relation(fields: [addressId], references: [id])
  sellerOrders  SellerOrder[]
  items         OrderItem[]
  payments      Payment[]
}

model SellerOrder {
  id            String            @id @default(cuid())
  orderId       String
  sellerId      String
  status        SellerOrderStatus @default(PROCESSING)
  subtotalThb   Int
  shippingThb   Int
  commissionThb Int
  payoutThb     Int
  trackingNo    String?
  carrier       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  order         Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller        SellerProfile     @relation(fields: [sellerId], references: [id])
  items         OrderItem[]
  payout        Payout?

  @@index([sellerId])
  @@index([orderId])
}

model OrderItem {
  id            String         @id @default(cuid())
  orderId       String
  sellerOrderId String
  productId     String
  variantId     String
  productName   String
  variantLabel  String
  unitPriceThb  Int
  quantity      Int
  totalThb      Int
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrder   SellerOrder    @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id])
  variant       ProductVariant @relation(fields: [variantId], references: [id])
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  provider       String        @default("mock")
  sessionId      String        @unique
  idempotencyKey String        @unique
  status         PaymentStatus @default(PENDING)
  amountThb      Int
  expiresAt      DateTime
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model InventoryReservation {
  id        String         @id @default(cuid())
  orderId   String
  variantId String
  quantity  Int
  expiresAt DateTime
  released  Boolean        @default(false)
  createdAt DateTime       @default(now())
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([expiresAt])
}

model Payout {
  id            String        @id @default(cuid())
  sellerId      String
  sellerOrderId String        @unique
  amountThb     Int
  status        PayoutStatus  @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  seller        SellerProfile @relation(fields: [sellerId], references: [id])
  sellerOrder   SellerOrder   @relation(fields: [sellerOrderId], references: [id])
}

model AdminActionLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  note      String?
  createdAt DateTime @default(now())
  actor     User     @relation("AdminActor", fields: [actorId], references: [id])
}
